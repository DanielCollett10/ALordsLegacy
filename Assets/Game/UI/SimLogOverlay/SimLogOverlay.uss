.simlog {
    position: absolute;
    top: 48px;
    left: 12px;
    width: 520px;
    padding: 6px 10px;
    background-color: rgba(30, 24, 18, 0.9);
}
.simlog__title {
    color: rgb(240, 230, 210);
    background-color: rgba(0, 0, 0, 0);
    font-size: 14px;
    -unity-font-style: bold;
}
.simlog__toggles {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}
.simlog__toggle {
    color: rgb(240, 230, 210);
    background-color: rgba(0, 0, 0, 0);
    margin-right: 8px;
}
.simlog__toggle Label {
    color: rgb(240, 230, 210);
    background-color: rgba(0, 0, 0, 0);
}
.simlog__entry {
    color: rgb(240, 230, 210);
    background-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    white-space: normal;
}
