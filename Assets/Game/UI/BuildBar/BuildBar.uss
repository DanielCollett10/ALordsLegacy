.build-bar-root {
    position: absolute;
    left: 0; right: 0; bottom: 8px;
    align-items: center;
}
.build-bar {
    flex-direction: row;
    padding: 6px 10px;
    background-color: rgba(30, 24, 18, 0.9);
}
.build-bar__button { min-width: 90px; margin: 0 3px; color: rgb(240, 230, 210); background-color: rgb(70, 58, 44); }
.build-bar__button--active { background-color: rgb(190, 140, 50); color: rgb(20, 14, 8); }
.build-bar__button--disabled {
    color: rgb(130, 120, 105);
    background-color: rgb(45, 40, 34);
    border-width: 1px;
    border-color: rgb(110, 100, 85);
}
