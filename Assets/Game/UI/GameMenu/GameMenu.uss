.game-menu {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.game-menu__box {
    min-width: 260px;
    padding: 16px;
    background-color: rgb(30, 24, 18);
    border-width: 1px;
    border-color: rgb(110, 100, 85);
    border-radius: 4px;
}

.game-menu__title {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(240, 230, 210);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.game-menu__button {
    margin: 3px 0;
    padding: 6px;
    font-size: 14px;
}

.game-menu__content {
    min-height: 40px;
    margin-bottom: 8px;
}
