<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY performance-spike tests (perf-1, perf-2). Compiles the prototype code under
    Assets/Prototypes/PerfSpike like Sim.Tests compiles Assets/Sim. Nothing in LordsLegacy.Game or
    LordsLegacy.Editor references it, so perf-3b can delete Assets/Prototypes and Perf.Tests together.
    Perf runs are [Explicit] and [Category("Perf")]; run them with:
      dotnet test Perf.Tests/Perf.Tests.csproj with a filter on TestCategory=Perf
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>LordsLegacy.Prototypes.PerfSpike.Tests</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Restore only from nuget.org, as Sim.Tests does. -->
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
    <RestoreFallbackFolders>clear</RestoreFallbackFolders>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/Prototypes/PerfSpike/**/*.cs" Link="PerfSpike/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
